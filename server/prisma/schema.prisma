generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Client {
  id            String         @id
  username      String         @unique
  passwordHash  String
  parentName    String
  phone         String
  email         String?        @unique
  kidName       String
  kidAge        Int
  createdAt     DateTime       @default(now())

  registrations Registration[]
}

model Lesson {
  id            Int            @id @default(autoincrement())
  lessonType    String
  title         String
  description   String
  day           Int
  startHour     Int
  duration      Int

  registrations Registration[]
}

model Registration {
  id        Int      @id @default(autoincrement())
  clientId  String
  lessonId  Int
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([clientId, lessonId])
}